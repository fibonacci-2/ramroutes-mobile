# Copy this file to .env and fill in the current values.
# The tagging model's ngrok URL changes frequently - update TAGGER_URL here
# whenever a new tunnel is started, no code changes needed.

TAGGER_URL=https://your-ngrok-subdomain.ngrok-free.app
TAGGER_API_KEY=your-api-key

# OpenRouter key for embedder.js (qwen/qwen3-embedding-8b) - platform.openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key
