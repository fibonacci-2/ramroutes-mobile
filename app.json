{
  "expo": {
    "name": "ramroutes-mobile",
    "slug": "ramroutes-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edgoanalytics.ramroutesmobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RamRoutes uses your location to show events happening at buildings near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RamRoutes uses your location in the background to notify you about events at buildings you're near.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.edgoanalytics.ramroutesmobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyCc8mhgaducR12eYuXQm-ZNbx_o1GbmeMM",
          "androidGoogleMapsApiKey": "AIzaSyBf6XU9a9CnFwW4nYsUYXMRV_i7_X9sxgo"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RamRoutes uses your location to show events happening at buildings near you."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics"
    ]
  }
}
